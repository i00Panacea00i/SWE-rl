# ===== 密钥与环境（绝不入库）=====
.env
.env.*
!.env.example
*.pem
*.key
credentials*

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== 运行产物与大文件 =====
artifacts/*
# 例外1：Phase A pilot 轨迹样本（16 个 jsonl，2026-09-10 tracing 冒烟记录）
!artifacts/traces/
# 例外2：30B tier0-r1 训练轨迹归档（1692 条 episode = 352MB，压缩为 67MB tar.gz，2026-09-22）
#   注：git 不允许跨越被忽略的父目录，故逐级放行到目标单文件
!artifacts/archive/
artifacts/archive/*
!artifacts/archive/cfs-traces-30b/
artifacts/archive/cfs-traces-30b/*
!artifacts/archive/cfs-traces-30b/swegym-30b-tier0-r1.tar.gz
output/
logs/
*.log
# 例外：数据案例中的判分日志（test.log 是轨迹证据的一部分，须在 *.log 之后声明）
!artifacts/traces/**/judge/test.log
*.tgz
*.tmp
# 仅忽略仓库根目录的 traces/（避免连坐 artifacts/traces 例外）
/traces/
checkpoints/
eval_reports/
monitor/

# ===== 内部汇报材料（不入公开仓库）=====
briefing/

# ===== 数据：保留源数据/协议/脚本与实际使用的冻结切分，排除可再生中间切分 =====
data/round0*/

# ===== IDE / 系统 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ===== 构建产物 =====
dist/
build/
*.whl

# 数据切分 parquet 为二进制产物（含镜像地址），可由 prepare_data.py 再生，不入库
*.parquet
